DEBUG=true
LOG_LEVEL=DEBUG

# Postgres container (compose.yml). POSTGRES_USER is created as the owner/migrator role
POSTGRES_USER=app_migrator
POSTGRES_PASSWORD=password
POSTGRES_DB=saint_elmo

# Owner role: runs Alembic migrations
DB_URL=postgresql+asyncpg://app_migrator:password@localhost:5432/saint_elmo
# Non-superuser role the app connects as (RLS applies)
APP_DB_URL=postgresql+asyncpg://app_runtime:password@localhost:5432/saint_elmo

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Fernet keys for EncryptedString, newest first. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEYS=[]

# Static Valio Aimo data set (product JSON + CSVs), relative to the working directory
CATALOG_DATA_DIR=../data
