DEBUG=true
LOG_LEVEL=DEBUG

POSTGRES_USER=app_migrator
POSTGRES_PASSWORD=password
POSTGRES_DB=saint_elmo

DB_URL=postgresql+asyncpg://app_migrator:password@localhost:5432/saint_elmo

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# User session signing key (HS256).
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-replace-me-with-a-generated-one

# Agent token signing key (Ed25519, base64url of 32 raw bytes).
# Generate with: uv run python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AGENT_TOKEN_SIGNING_KEY=

# Fernet keys for EncryptedString, newest first. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEYS=[]

# Static Valio Aimo data set (product JSON + CSVs), relative to the working directory
CATALOG_DATA_DIR=../data
# Export date of the static data set, reported as catalogue provenance
CATALOG_SNAPSHOT_DATE=2026-11-13
