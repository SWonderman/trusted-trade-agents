# Where server-side data comes from: "mock" (in-memory demo data) or "http" (FastAPI backend).
API_MODE=mock
# Switch single areas to the real backend as their endpoints land. Any "http" area
# needs API_MODE_AUTH=http too, since the backend only accepts sessions it signed.
# What the backend serves today: sign-in and the catalog.
# API_MODE_AUTH=http
# API_MODE_CATALOG=http
# API_MODE_ORDERS=
# API_MODE_AGENTS=
# API_MODE_AUDIT=
# API_MODE_OVERSIGHT=
BACKEND_URL=http://localhost:8000
# "false" only for local development over plain http
SESSION_COOKIE_SECURE=true
