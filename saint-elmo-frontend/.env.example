# Where server-side data comes from: "mock" (in-memory demo data) or "http" (FastAPI backend).
API_MODE=mock
# Switch single areas to the real backend as their endpoints land, e.g. API_MODE_ORDERS=http
# API_MODE_AUTH=
# API_MODE_ORDERS=
# API_MODE_AGENTS=
# API_MODE_AUDIT=
# API_MODE_OVERSIGHT=
BACKEND_URL=http://localhost:8000
# "false" only for local development over plain http
SESSION_COOKIE_SECURE=true
